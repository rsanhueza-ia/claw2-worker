# =============================================
# ClawVoice Worker - Configuración de Ejemplo
# =============================================
# Copia este archivo a .env y completa con tus valores
#
# Obtener valores de Supabase:
# - SUPABASE_URL: Configuración -> API -> Project URL
# - SUPABASE_SERVICE_ROLE_KEY: Configuración -> API -> service_role (secret)
#
# Obtener valores de OpenClaw:
# - OPENCLAW_URL: Generalmente http://127.0.0.1:18789 (localhost)
# - MODEL: openclaw (dejar que tu openclaw administre el modelo)
# =============================================

# ---- Supabase ----
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ---- OpenClaw ----
OPENCLAW_URL=http://127.0.0.1:18789
MODEL=openclaw


